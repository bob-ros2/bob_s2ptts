# LAN build mirrors for `docker compose build` — copy to .env and adjust.
# Left empty, the Dockerfile falls back to stock Ubuntu/PyPI sources.
# APT mirrors need an Ubuntu (jammy) remote in Nexus first; Debian-only
# proxies return 404 for jammy.
APT_UBUNTU_MIRROR=
APT_SECURITY_MIRROR=
PIP_INDEX_URL=
PIP_TRUSTED_HOST=
